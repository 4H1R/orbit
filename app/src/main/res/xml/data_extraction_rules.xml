<?xml version="1.0" encoding="utf-8"?>
<!-- Orbit's only way off the device is its own encrypted Backup (ADR 0002, ADR 0004).
     Android's cloud backup and device-to-device transfer are both excluded. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
